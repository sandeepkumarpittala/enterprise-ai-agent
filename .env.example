# Application
APP_NAME=Enterprise AI Knowledge & Data Agent
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL
# Use the connection string format:
# postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/enterprise_ai
DATABASE_URL=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local LLM
# Ollama runs locally; configure the model and endpoint as required by your application.
LLM_API_KEY=

# Authentication
# Set a strong, randomly generated secret for local development.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
